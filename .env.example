# Local demonstration only. Use a URL-safe password; never reuse a real password.
POSTGRES_USER=cartmates
POSTGRES_PASSWORD=cartmates_local_only
POSTGRES_DB=cartmates
WEB_PORT=8080
DB_PORT=5432
# Used by host-side Prisma and API development; Compose uses its internal db hostname.
DATABASE_URL=postgresql://cartmates:cartmates_local_only@localhost:5432/cartmates
