    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "dotenv": "^17.2.0",
    "fastify": "5.12.7",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "tsx": "^4.20.0"
  }
