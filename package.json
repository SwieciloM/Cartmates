{
  "name": "cartmates",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @cartmates/api\" \"npm run dev -w @cartmates/web\"",
    "db:generate": "npm run db:generate -w @cartmates/api",
    "db:migrate": "npm run db:migrate -w @cartmates/api",
    "typecheck": "npm run db:generate && npm run typecheck --workspaces && tsc -p tsconfig.tests.json",
    "build": "npm run typecheck && npm run build --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=chromium",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^17.13.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
